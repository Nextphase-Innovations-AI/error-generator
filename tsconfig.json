{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "runtime-errors/**/*.ts",
    "api-errors/**/*.ts",
    "security-alerts/codeql/**/*.ts",
    "*.ts"

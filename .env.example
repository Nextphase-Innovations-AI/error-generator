# Copy to .env and fill in. Every variable the repository reads is listed here.

# GitHub token used by the runtime-error reporter (yarn report) and the API error client
# (yarn api-errors). Locally: export GITHUB_TOKEN=$(gh auth token). In Actions the built-in
# token is injected by the report-runtime-errors workflow. Never commit a real value.
GITHUB_TOKEN=

# owner/name of the test repository the reporter opens issues in. Set automatically in Actions.
GITHUB_REPOSITORY=

# Where the runtime error service listens (yarn start) and where the reporter looks for it.
HOST=127.0.0.1
PORT=3000
ERROR_SERVICE_URL=http://127.0.0.1:3000
